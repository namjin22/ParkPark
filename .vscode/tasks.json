{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ParkPark: Verify",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\verify.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "ParkPark: Rojo Serve",
      "type": "process",
      "command": "${env:USERPROFILE}\\.aftman\\bin\\rojo.exe",
      "args": ["serve", "default.project.json"],
      "problemMatcher": []
    }
  ]
}
